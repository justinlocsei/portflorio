{
  "name": "portflorio",
  "version": "1.0.0",
  "description": "A floral portfolio",
  "homepage": "https://github.com/justinlocsei/portflorio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justinlocsei/portflorio.git"
  },
  "author": "Justin Locsei",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "check": "npm run check:code && npm run check:formatting && npm run check:types",
    "check:code": "biome lint . --error-on-warnings",
    "check:formatting": "biome ci --linter-enabled=false . && dprint check",
    "check:types": "tsc --noEmit",
    "format": "biome check --write --linter-enabled=false . && dprint fmt",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "dprint": "^0.57.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "dprint@0.57.4": true,
    "fsevents@2.3.3": true
  }
}
